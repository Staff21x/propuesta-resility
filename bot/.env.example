# === API Keys ===
ANTHROPIC_API_KEY=sk-ant-...

# === Configuración del bot ===
# Número de WhatsApp del bot (con código país, sin +)
BOT_NUMBER=56900000000

# Número del operador humano (para escalamiento)
OPERATOR_NUMBER=56952084228

# === Modelo Claude ===
# Usar haiku para velocidad máxima. Cambiar a sonnet solo si la calidad no es suficiente.
# claude-haiku-4-5-20251001  → ~1-2s  (recomendado)
# claude-sonnet-4-6           → ~3-5s  (si necesitas más capacidad)
CLAUDE_MODEL=claude-haiku-4-5-20251001

# === Webhook (opcional) ===
WEBHOOK_URL=
WEBHOOK_SECRET=

# === Historial de conversación ===
# Cuántos mensajes previos enviar al modelo (más = más lento)
MAX_HISTORY_MESSAGES=6

# === Redis (opcional, para historial persistente) ===
# Si no se configura, se usa memoria in-process
REDIS_URL=
